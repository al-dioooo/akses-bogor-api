                                "format": "uri"
                              },
                              "alt": {
                                "type": "string"
                              },
                              "caption": {
                                "nullable": true,
                                "type": "string"
                              },
                              "tag": {
                                "type": "string",
                                "enum": [
                                  "pintu_masuk",
                                  "toilet_difabel",
                                  "guiding_block",
                                  "lift",
                                  "lainnya"
                                ]
                              }
                            },
                            "required": [
                              "id",
                              "url",
                              "alt",
                              "caption",
                              "tag"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "category",
                          "district",
                          "status",
                          "summary",
                          "location",
                          "lastVerifiedAt",
                          "coverPhoto"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "total",
                    "limit",
                    "offset",
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Galat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "galat": {
                      "type": "string",
                      "description": "Kode galat snake_case yang stabil"
