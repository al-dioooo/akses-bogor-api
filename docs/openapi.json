  "paths": {
    "/healthz": {
      "get": {
        "summary": "Cek server hidup",
        "tags": [
          "Sistem"
        ],
        "description": "Dipakai health check Azure App Service. Tidak menyentuh database.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/districts": {
      "get": {
        "summary": "Daftar kecamatan",
        "tags": [
          "Lokasi"
        ],
        "description": "Enam kecamatan Kota Bogor (ADR-0010) dengan jumlah lokasi terbit, untuk filter kecamatan.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "city": {
                        "type": "string"
                      },
                      "places": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "slug",
                      "name",
                      "city",
                      "places"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/places": {
      "get": {
        "summary": "Daftar lokasi untuk Jelajahi",
        "tags": [
          "Lokasi"
        ],
