# Contoh /etc/akses-bogor/backup.env untuk salinan cadangan ke R2 (ADR-0025). Berkas aslinya tidak di-commit.
# Pemilik root:root, mode 0600. systemd membacanya sebagai root, jadi user API tidak bisa membacanya.
#
# Bucket privat, terpisah dari bucket foto, dengan lifecycle rule yang menghapus objek setelah 30 hari.
# Token R2 cukup Object Read & Write untuk bucket itu saja.

# Kosong berarti dump hanya disimpan di Evergarden. Contoh: r2:akses-bogor-backup/postgres
BACKUP_R2_REMOTE=

# rclone dikonfigurasi lewat environment, tanpa rclone.conf. Endpoint ada di dashboard R2.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
