# API AksesBogor di Evergarden (ADR-0026). Pasang ke /etc/systemd/system/, lihat README bagian Deployment.
[Unit]
Description=AksesBogor API
Documentation=https://github.com/al-dioooo/akses-bogor-api#deployment
After=network-online.target postgresql@17-main.service
Wants=network-online.target postgresql@17-main.service

[Service]
Type=simple
User=aksesbogor
Group=aksesbogor
# Tautan ke rilis aktif. deploy.sh memindahkannya, lalu akses-bogor-deploy.service me-restart service ini.
WorkingDirectory=/srv/akses-bogor/current
EnvironmentFile=/etc/akses-bogor/api.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3
# Evergarden dipakai bersama layanan lain dan tidak punya swap.
MemoryMax=512M

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
