# Dump database AksesBogor (ADR-0025, ADR-0026). Dipicu akses-bogor-backup.timer, atau langsung dengan
# `sudo systemctl start akses-bogor-backup`.
[Unit]
Description=Cadangan database AksesBogor
After=postgresql@17-main.service
Requires=postgresql@17-main.service

[Service]
Type=oneshot
# User postgres masuk lewat peer, dan dump-nya tidak bisa dibaca user API.
User=postgres
Group=postgres
Environment=PGPORT=5433 PGDATABASE=aksesbogor BACKUP_DIR=/var/backups/akses-bogor
# Kredensial R2 untuk rclone. Tanda - berarti berkas boleh belum ada; tanpa berkas, dump hanya disimpan lokal.
EnvironmentFile=-/etc/akses-bogor/backup.env
Environment=RCLONE_CACHE_DIR=/tmp/rclone
ExecStart=/usr/local/lib/akses-bogor/backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/akses-bogor
