# Membangun ulang ubin Valhalla Kota Bogor dari ekstrak Geofabrik terbaru (ADR-0055). Dipicu
# akses-bogor-valhalla-ubin.timer, atau langsung dengan `sudo systemctl start akses-bogor-valhalla-ubin`.
[Unit]
Description=Bangun ulang ubin Valhalla AksesBogor
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# User valhalla ada di grup docker untuk menjalankan kontainer pembangun; berkas di /srv/valhalla miliknya.
User=valhalla
Group=valhalla
SupplementaryGroups=docker
Environment=VALHALLA_DATA_DIR=/srv/valhalla
ExecStart=/usr/local/lib/akses-bogor/valhalla/ubin.sh
# Awalan + menjalankan restart sebagai root. Valhalla baru membaca ubin baru setelah restart.
ExecStartPost=+/usr/bin/systemctl restart akses-bogor-valhalla.service
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/valhalla
