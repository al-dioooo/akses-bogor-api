# Valhalla untuk rute pejalan kaki aksesibel AksesBogor (ADR-0055). Pasang ke /etc/systemd/system/; langkahnya ada di
# runbook operations/valhalla-rute-aksesibel.md di akses-bogor-docs.
[Unit]
Description=Valhalla rute pejalan kaki AksesBogor
After=docker.service network-online.target
Requires=docker.service
# Belum ada ubin: jalankan akses-bogor-valhalla-ubin.service dulu.
ConditionPathExists=/srv/valhalla/aktif/valhalla.json

[Service]
Type=simple
Environment=VALHALLA_IMAGE=akses-bogor-valhalla:3.9.3 VALHALLA_PORT=8002
ExecStartPre=-/usr/bin/docker rm -f akses-bogor-valhalla
# Hanya di 127.0.0.1: yang memanggilnya API di host yang sama. Data dibaca saja, sebagai user nobody. Log Valhalla
# tidak memuat koordinat permintaan, hanya nomor permintaan dan kode status.
ExecStart=/usr/bin/docker run --rm --name akses-bogor-valhalla \
  --read-only --tmpfs /tmp --user 65534:65534 \
  --memory 512m --memory-swap 512m --cpus 1 \
  --log-opt max-size=5m --log-opt max-file=2 \
  -p 127.0.0.1:${VALHALLA_PORT}:8002 \
  -v /srv/valhalla:/data:ro \
  ${VALHALLA_IMAGE} valhalla_service /data/aktif/valhalla.json 2
ExecStop=/usr/bin/docker stop -t 10 akses-bogor-valhalla
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
