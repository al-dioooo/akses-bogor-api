# Contoh /etc/akses-bogor/api.env di Evergarden (ADR-0026). Berkas aslinya tidak di-commit.
# Pemilik root:aksesbogor, mode 0640. Dibaca akses-bogor-api.service dan deploy.sh.
NODE_ENV=production
HOST=127.0.0.1
# Port 8080 sudah dipakai layanan lain di Evergarden.
PORT=8090

# Lewat Unix socket dengan autentikasi peer: user sistem dan role database sama-sama aksesbogor, jadi tanpa
# password. Parameter host menunjuk folder socket; port 5433 karena 5432 dipakai container lain.
DATABASE_URL=postgresql://aksesbogor@localhost:5433/aksesbogor?host=/var/run/postgresql

# Origin web di Vercel, dipisah koma. Tambahkan domain sendiri bila sudah dipasang.
FRONTEND_ORIGINS=https://akses-bogor.vercel.app

# Alamat publik bucket foto R2. Kosong selama foto belum dipakai.
PHOTO_PUBLIC_URL=
