# Contoh /etc/akses-bogor/api.env di Evergarden (ADR-0026). Berkas aslinya tidak di-commit.
# Pemilik root:aksesbogor, mode 0640. Dibaca akses-bogor-api.service dan deploy.sh.
NODE_ENV=production
HOST=127.0.0.1
# Port 8080 sudah dipakai layanan lain di Evergarden.
PORT=8090

# Lewat Unix socket dengan autentikasi peer: user sistem dan role database sama-sama aksesbogor, jadi tanpa
# password. Parameter host menunjuk folder socket; port 5433 karena 5432 dipakai container lain.
DATABASE_URL=postgresql://aksesbogor@localhost:5433/aksesbogor?host=/var/run/postgresql

# Origin web di Vercel, dipisah koma. Tambahkan domain sendiri bila sudah dipasang.
FRONTEND_ORIGINS=https://akses-bogor.vercel.app

# Alamat publik bucket foto R2. Kosong selama foto belum dipakai.
PHOTO_PUBLIC_URL=

# Mapbox untuk halaman Peta (ADR-0016): token rahasia ber-scope tokens:write, styles:read, styles:tiles, dan
# fonts:read, serta username akunnya. Token yang sama dipakai untuk pencarian tempat di formulir laporan (ADR-0032).
# Kosong berarti GET /map/token dan POST /map/search menjawab 503, dan web hanya menampilkan daftar.
MAPBOX_SECRET_TOKEN=
MAPBOX_USERNAME=

# Akun (ADR-0029). Rahasia diisi sendiri, minimal 32 karakter acak (mis. `openssl rand -base64 48`). Mengganti nilainya
# mengakhiri semua sesi. Kosong berarti route akun menjawab 503.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://akses-bogor-api.yorhagarden.xyz
# Client ID OAuth Google (bukan rahasia), sama dengan NEXT_PUBLIC_GOOGLE_CLIENT_ID di Vercel.
GOOGLE_CLIENT_ID=

# Email lewat Resend (ADR-0030): API key ber-izin "Sending access" untuk domain pengirim saja, dan alamat pengirim pada
# domain yang sudah diverifikasi. Kosong berarti permintaan kode menjawab 503; masuk dengan Google tetap bisa.
RESEND_API_KEY=
EMAIL_FROM=
