# Contoh /etc/akses-bogor/api.env di Evergarden (ADR-0026). Berkas aslinya tidak di-commit.
# Pemilik root:aksesbogor, mode 0640. Dibaca akses-bogor-api.service dan deploy.sh.
NODE_ENV=production
HOST=127.0.0.1
# Port 8080 sudah dipakai layanan lain di Evergarden.
PORT=8090

# Lewat Unix socket dengan autentikasi peer: user sistem dan role database sama-sama aksesbogor, jadi tanpa
# password. Parameter host menunjuk folder socket; port 5433 karena 5432 dipakai container lain.
DATABASE_URL=postgresql://aksesbogor@localhost:5433/aksesbogor?host=/var/run/postgresql

# Origin web, dipisah koma. Web berjalan di Evergarden di belakang Cloudflare (ADR-0048). Origin pertama dipakai untuk
# tautan di email status laporan, jadi alamat utama (staging di aldio.dev, ADR-0045) di depan.
FRONTEND_ORIGINS=https://akses-bogor.aldio.dev

# Alamat publik bucket foto R2 (custom domain bucket akses-bogor-foto). Kosong berarti alamat foto di respons null.
PHOTO_PUBLIC_URL=https://akses-bogor-foto.aldio.dev

# Mapbox untuk halaman Peta (ADR-0016): token rahasia ber-scope tokens:write, styles:read, styles:tiles, dan
# fonts:read, serta username akunnya. Token yang sama dipakai untuk pencarian tempat di formulir laporan (ADR-0032).
# Kosong berarti GET /map/token dan POST /map/search menjawab 503, dan web hanya menampilkan daftar.
# Token yang sama dipakai untuk rute jalan kaki agen rute (Mapbox Directions, ADR-0042).
MAPBOX_SECRET_TOKEN=
MAPBOX_USERNAME=

# Agen rute (ADR-0042). Tetap false sampai syarat peluncurannya terpenuhi (ADR fase 2 diterima dan Kebijakan Privasi
# versi baru berlaku).
ROUTE_AGENT_ENABLED=false
# Prioritas kecamatan dari data disabilitas Open Data Kota Bogor (ADR-0043). Tetap false sampai Diskominfo Kota Bogor
# mengizinkan pemakaian datanya.
DISABILITY_DATA_ENABLED=false
# Penyedia model agen (ADR-0047): anthropic (Claude API) atau openrouter. Tidak ada cadangan otomatis.
AGENT_PROVIDER=anthropic
# Permintaan ke model yang berhasil per hari untuk semua pengguna. Kosong berarti 45.
AGENT_REQUESTS_PER_DAY=
# API key Claude API, diisi sendiri. Kosong berarti agen menjawab sibuk; API tetap jalan.
ANTHROPIC_API_KEY=
# Model Claude dan effort (low, medium, atau high). Kosong berarti claude-haiku-5-5 dan effort low.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
# API key OpenRouter bila AGENT_PROVIDER=openrouter, diisi sendiri. Kosong berarti agen menjawab sibuk.
OPENROUTER_API_KEY=
# Model OpenRouter berurutan, dipisah koma; model pertama dicoba dulu. Kosong berarti daftar bawaan API.
OPENROUTER_MODELS=

# Akun (ADR-0029). Rahasia diisi sendiri, minimal 32 karakter acak (mis. `openssl rand -base64 48`). Mengganti nilainya
# mengakhiri semua sesi. Kosong berarti route akun menjawab 503.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://akses-bogor-api.aldio.dev
# Client ID OAuth Google (bukan rahasia), sama dengan NEXT_PUBLIC_GOOGLE_CLIENT_ID di web.env akses-bogor-web.
GOOGLE_CLIENT_ID=

# Email lewat Resend (ADR-0030): API key ber-izin "Sending access" untuk domain pengirim saja, dan alamat pengirim pada
# domain yang sudah diverifikasi. Kosong berarti permintaan kode menjawab 503; masuk dengan Google tetap bisa.
RESEND_API_KEY=
EMAIL_FROM=

# Foto laporan di Cloudflare R2 (ADR-0031): ID akun Cloudflare, token R2 ber-izin "Object Read & Write" untuk dua bucket
# foto saja, bucket privat untuk foto yang belum terbit, dan bucket publik di balik PHOTO_PUBLIC_URL. Kosong berarti
# unggah foto menjawab 503 dan laporan tetap bisa dikirim tanpa foto.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_LAPORAN=
R2_BUCKET_PUBLIK=

# Rahasia bersama dengan server Next.js, diisi sendiri dengan nilai yang sama seperti WEB_SERVER_SECRET di web.env.
# Server web memanggil API lewat Cloudflare dari IP Evergarden, jadi tanpa ini semua pengunjung web berbagi satu kuota
# rate limit.
WEB_SERVER_SECRET=
