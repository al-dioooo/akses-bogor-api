# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=development
PORT=8080

# PostgreSQL lokal dengan PostGIS dan pg_trgm, untuk aplikasi, migrasi, dan seed.
DATABASE_URL=postgresql://aksesbogor:password@localhost:5432/aksesbogor

# Origin web yang boleh memanggil API, dipisah koma.
FRONTEND_ORIGINS=http://localhost:3000

# Alamat publik bucket foto Cloudflare R2, mis. https://foto.aksesbogor.id. Kosongkan bila belum ada.
PHOTO_PUBLIC_URL=

# Mapbox untuk halaman Peta (ADR-0016): token rahasia ber-scope tokens:write, styles:read, styles:tiles, dan
# fonts:read, serta username akunnya. API memakainya untuk membuat token sementara bagi browser.
# Kosongkan keduanya bila belum ada; GET /map/token lalu menjawab 503.
MAPBOX_SECRET_TOKEN=
MAPBOX_USERNAME=
