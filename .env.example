# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=development
PORT=8080

# Neon Postgres (Singapura) dengan PostGIS. Pooled untuk aplikasi, unpooled untuk migrasi.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/aksesbogor?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/aksesbogor?sslmode=verify-full

# Origin web yang boleh memanggil API, dipisah koma.
FRONTEND_ORIGINS=http://localhost:3000

# Alamat publik bucket foto Cloudflare R2, mis. https://foto.aksesbogor.id. Kosongkan bila belum ada.
PHOTO_PUBLIC_URL=
