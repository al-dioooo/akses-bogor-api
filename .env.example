# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=development
PORT=8080

# PostgreSQL lokal dengan PostGIS dan pg_trgm, untuk aplikasi, migrasi, dan seed.
DATABASE_URL=postgresql://aksesbogor:password@localhost:5432/aksesbogor

# Origin web yang boleh memanggil API, dipisah koma. Origin pertama juga dipakai untuk tautan di email status laporan.
FRONTEND_ORIGINS=http://localhost:3000

# Alamat publik bucket foto Cloudflare R2, mis. https://foto.aksesbogor.id. Kosongkan bila belum ada.
PHOTO_PUBLIC_URL=

# Mapbox untuk halaman Peta (ADR-0016): token rahasia ber-scope tokens:write, styles:read, styles:tiles, dan
# fonts:read, serta username akunnya. API memakainya untuk membuat token sementara bagi browser.
# Token yang sama dipakai API untuk pencarian tempat di formulir laporan (POST /map/search, ADR-0032).
# Kosongkan keduanya bila belum ada; GET /map/token dan POST /map/search lalu menjawab 503.
MAPBOX_SECRET_TOKEN=
MAPBOX_USERNAME=

# Akun (ADR-0029). Kosong di development: API memakai rahasia tetap khusus lokal. Di production isi minimal 32
# karakter acak, mis. hasil `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Alamat publik API ini.
BETTER_AUTH_URL=http://localhost:8080
# Client ID OAuth Google (tipe Web application). Kosong berarti masuk dengan Google mati.
GOOGLE_CLIENT_ID=

# Email lewat Resend (ADR-0030). Kosong di development berarti kode masuk dicetak ke log API, tidak dikirim.
RESEND_API_KEY=
EMAIL_FROM=

# Foto laporan (ADR-0031). Kosong di development berarti foto disimpan di folder lokal PHOTO_STORAGE_DIR
# (bawaan .data/foto). Kelima variabel R2 diisi bersama.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_LAPORAN=
R2_BUCKET_PUBLIK=
PHOTO_STORAGE_DIR=

# Rahasia bersama dengan server Next.js, sama dengan WEB_SERVER_SECRET di akses-bogor-web. Minimal 32 karakter,
# mis. hasil `openssl rand -hex 32`. Kosongkan bila web tidak mengirimnya.
WEB_SERVER_SECRET=
